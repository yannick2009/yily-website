---
import Icon from "./Icon.astro";

// The hero recreation of the real Yily variables screen. Values are demo data;
// only the eye controls are interactive (reveal + countdown).
const rows = [
  {
    name: "STRIPE_SECRET_KEY",
    tags: ["prod", "api"],
    value: "sk_live_51MvY8wD2eK9qFn4Lh7Tp",
    auto: false,
  },
  {
    name: "DATABASE_URL",
    tags: ["prod", "database"],
    value: "postgres://yily:9f3ab2@db:5432/core",
    auto: false,
  },
  {
    name: "JWT_SECRET",
    tags: ["prod", "api"],
    value: "hS7pQ2mX9vL4kR8tW1zN6yB3cF5jD0aE7gH2",
    auto: true,
  },
  {
    name: "SMTP_PASSWORD",
    tags: ["prod", "mail"],
    value: "m4il-9f27c1!",
    auto: false,
  },
];
---

<div class="app-frame">
  <div class="frame-bar">
    <div class="win-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="frame-address">
      <Icon name="lock" size={10} />
      <span class="frame-host">yily.example.com</span>
      <span class="frame-sep">/</span>
      <span class="frame-path">projects / acme / production</span>
    </div>
    <span class="frame-badge"><span class="frame-live-dot"></span><span>Encrypted at rest</span></span>
  </div>

  <div class="app">
    <aside class="app-side" aria-hidden="true">
      <div class="app-brand">
        <img src="/logo.svg" alt="" width="180" height="169" loading="lazy" decoding="async" />
      </div>

      <nav class="app-nav">
        <span class="app-nav-label">Workspace</span>
        <span class="app-nav-item"><Icon name="dashboard" size={14} />Dashboard</span>
        <span class="app-nav-item is-active"><Icon name="folder" size={14} />Projects</span>
        <span class="app-nav-item"><Icon name="key" size={14} />Tokens</span>
        <span class="app-nav-item"><Icon name="clock" size={14} />Audit log</span>
      </nav>

      <div class="app-side-bottom">
        <span class="app-nav-item"><Icon name="settings" size={14} />Settings</span>
        <span class="app-nav-item"><Icon name="moon" size={14} />Theme<span class="app-theme-value">Dark</span></span>
      </div>

      <div class="app-user">
        <span class="app-avatar">Y</span>
        <span class="app-user-copy">
          <strong>Yannick</strong>
          <span>admin@yily.local</span>
        </span>
        <span class="app-logout"><Icon name="logout" size={13} /></span>
      </div>
    </aside>

    <div class="app-content">
      <span class="app-back"><Icon name="arrow-left" size={12} /> Acme</span>

      <div class="app-page-head">
        <div class="app-page-title">
          <div class="app-title-row">
            <span class="app-title">Production</span>
            <span class="app-edit"><Icon name="pencil" size={12} /></span>
          </div>
          <div class="app-desc">
            <span>Live API and infrastructure secrets.</span>
            <span class="app-edit app-edit-small"><Icon name="pencil" size={10} /></span>
          </div>
        </div>
        <div class="app-head-actions">
          <span class="app-button"><Icon name="upload" size={12} />Import</span>
          <span class="app-button"><Icon name="download" size={12} />Export</span>
          <span class="app-button primary"><Icon name="plus" size={12} />New variable</span>
        </div>
      </div>

      <div class="app-toolbar">
        <div class="app-search">
          <Icon name="search" size={13} />
          <span>Search variables…</span>
        </div>
        <div class="app-sort">
          <span class="app-tool-label">Sort</span>
          <span class="app-sort-pill is-active">Name <span class="sort-arrow">↑</span></span>
          <span class="app-sort-pill">Date</span>
        </div>
      </div>

      <div class="app-filters">
        <span class="app-tool-label">Filter</span>
        <span class="app-filter is-active">prod</span>
        <span class="app-filter">api</span>
        <span class="app-filter">database</span>
        <span class="app-filter">mail</span>
      </div>

      <div class="app-table">
        <div class="app-table-head" aria-hidden="true">
          <span>Name</span>
          <span class="app-center">Status</span>
          <span>Value</span>
          <span>Tags</span>
          <span class="app-right">Actions</span>
        </div>

        {
          rows.map((row) => (
            <div
              class:list={["app-row", { "auto-reveal": row.auto }]}
              data-secret-row
              data-plain={row.value}
              data-auto-reveal={row.auto ? "" : undefined}
            >
              <div class="app-name">
                <span class="app-var-name" data-var-name>{row.name}</span>
              </div>
              <div class="app-status"><span class="app-status-dot"></span></div>
              <div class="app-value">
                <span class="value-text" data-value aria-hidden="true">••••••••••</span>
                <span class="app-countdown" data-countdown hidden>
                  <Icon name="clock" size={9} />
                  <span data-countdown-seconds>20</span>s
                </span>
              </div>
              <div class="app-tags">
                {row.tags.map((tag) => <span class="app-tag">{tag}</span>)}
              </div>
              <div class="app-actions">
                <button
                  type="button"
                  class="app-icon-btn"
                  data-reveal-toggle
                  aria-label={`Reveal ${row.name}`}
                  aria-pressed="false"
                >
                  <span class="eye-show"><Icon name="eye" size={13} /></span>
                  <span class="eye-hide"><Icon name="eye-off" size={13} /></span>
                </button>
                <span class="app-icon-btn is-ghost"><Icon name="copy" size={13} /></span>
                <span class="app-icon-btn is-ghost is-danger"><Icon name="trash" size={13} /></span>
              </div>
            </div>
          ))
        }

        <div class="app-row app-row-inactive">
          <div class="app-name">
            <span class="app-var-name">LEGACY_API_KEY</span>
            <span class="app-needs">Needs value</span>
          </div>
          <div class="app-status"><span class="app-status-dot is-inactive"></span></div>
          <div class="app-value"><span class="value-text is-empty">– – – – –</span></div>
          <div class="app-tags"></div>
          <div class="app-actions">
            <span class="app-icon-btn is-disabled"><Icon name="eye" size={13} /></span>
            <span class="app-icon-btn is-ghost is-disabled"><Icon name="copy" size={13} /></span>
            <span class="app-icon-btn is-ghost is-disabled"><Icon name="trash" size={13} /></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .app-frame {
    --app-bg: #0a0a0b;
    --app-surface: #18181b;
    --app-surface-2: #1c1c20;
    --app-surface-3: #121215;
    --app-line: #2b2b30;
    --app-line-soft: #232327;
    --app-text: #f4f4f5;
    --app-muted: #a1a1aa;
    --app-faint: #71717a;
    --app-dim: #52525b;
    --app-brand: #a855f7;
    --app-brand-bright: #c084fc;

    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 18px;
    background: var(--app-bg);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.07) inset,
      0 40px 110px -25px rgba(0, 0, 0, 0.9),
      0 0 80px rgba(124, 58, 237, 0.12);
    text-align: left;
  }

  .app-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      130deg,
      rgba(196, 181, 253, 0.3),
      rgba(255, 255, 255, 0.02) 30%,
      transparent 58%,
      rgba(232, 121, 249, 0.14)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Browser-style frame */
  .frame-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    height: 42px;
    padding: 0 0.9rem;
    border-bottom: 1px solid var(--app-line-soft);
    background: #101013;
  }

  .win-dots {
    display: flex;
    gap: 6px;
  }

  .win-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2c2c31;
  }

  .win-dots span:first-child {
    background: #3b303f;
  }

  .frame-address {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 0;
    color: var(--app-faint);
    font-family: var(--font-code);
    font-size: 0.6rem;
  }

  .frame-host {
    overflow: hidden;
    color: #b4b4be;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .frame-sep {
    opacity: 0.5;
  }

  .frame-path {
    overflow: hidden;
    color: var(--app-brand-bright);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .frame-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.24rem 0.55rem;
    border: 1px solid rgba(94, 234, 212, 0.16);
    border-radius: 999px;
    background: rgba(94, 234, 212, 0.05);
    color: rgba(204, 251, 241, 0.72);
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .frame-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px rgba(94, 234, 212, 0.8);
  }

  /* App shell */
  .app {
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
    min-height: 478px;
    background: var(--app-bg);
  }

  .app-side {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 0.6rem 0.6rem;
    border-right: 1px solid var(--app-line);
    background: var(--app-surface);
  }

  .app-brand {
    display: grid;
    height: 94px;
    place-items: center;
  }

  .app-brand img {
    width: auto;
    height: 47px;
    filter: drop-shadow(0 0 18px rgba(131, 56, 236, 0.24));
  }

  .app-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 0.3rem;
  }

  .app-nav-label {
    padding: 0.45rem 0.7rem 0.35rem;
    color: var(--app-dim);
    font-family: var(--font-body);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .app-nav-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.48rem 0.68rem;
    border-radius: 7px;
    color: var(--app-muted);
    font-size: 0.75rem;
    font-weight: 460;
    line-height: 1.2;
    white-space: nowrap;
  }

  .app-nav-item > svg {
    flex: none;
    opacity: 0.8;
  }

  .app-nav-item.is-active {
    background: var(--app-brand);
    color: #fff;
    box-shadow: 0 7px 20px rgba(168, 85, 247, 0.24);
  }

  .app-nav-item.is-active > svg {
    opacity: 1;
  }

  .app-side-bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
    padding-top: 0.55rem;
    border-top: 1px solid var(--app-line-soft);
  }

  .app-theme-value {
    margin-left: auto;
    color: var(--app-dim);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 500;
  }

  .app-user {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    margin-top: 0.55rem;
    padding: 0.65rem 0.4rem 0.05rem;
    border-top: 1px solid var(--app-line-soft);
  }

  .app-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: var(--app-brand);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
  }

  .app-user-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.35;
  }

  .app-user-copy strong {
    overflow: hidden;
    color: #e4e4e7;
    font-size: 0.67rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-user-copy span {
    overflow: hidden;
    color: var(--app-faint);
    font-family: var(--font-body);
    font-size: 0.56rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-logout {
    display: grid;
    place-items: center;
    flex: none;
    margin-left: auto;
    color: var(--app-faint);
  }

  /* Main page */
  .app-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.15rem 1.35rem 1.3rem;
    background: var(--app-bg);
  }

  .app-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    color: var(--app-faint);
    font-size: 0.7rem;
  }

  .app-page-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.45rem;
  }

  .app-page-title {
    min-width: 0;
  }

  .app-title-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .app-title {
    color: var(--app-text);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .app-edit {
    display: inline-flex;
    color: var(--app-dim);
  }

  .app-desc {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.28rem;
    color: var(--app-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .app-edit-small {
    opacity: 0.8;
  }

  .app-head-actions {
    display: flex;
    flex: none;
    gap: 0.4rem;
    padding-top: 0.15rem;
  }

  .app-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 31px;
    padding: 0 0.68rem;
    border: 1px solid var(--app-line);
    border-radius: 7px;
    background: var(--app-surface-2);
    color: #d4d4d8;
    font-size: 0.66rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .app-button.primary {
    border-color: transparent;
    background: linear-gradient(180deg, #b15cff, #9333ea);
    color: #fff;
    box-shadow:
      0 6px 16px rgba(168, 85, 247, 0.22),
      0 1px 0 rgba(255, 255, 255, 0.2) inset;
  }

  .app-toolbar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.15rem;
  }

  .app-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 270px;
    max-width: 100%;
    height: 34px;
    padding: 0 0.7rem;
    border: 1px solid var(--app-line);
    border-radius: 7px;
    background: var(--app-surface-3);
    color: var(--app-faint);
    font-size: 0.67rem;
  }

  .app-sort {
    display: flex;
    align-items: center;
    gap: 0.38rem;
  }

  .app-tool-label {
    color: var(--app-dim);
    font-family: var(--font-body);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .app-sort-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    height: 29px;
    padding: 0 0.55rem;
    border: 1px solid var(--app-line);
    border-radius: 6px;
    background: var(--app-surface-3);
    color: var(--app-muted);
    font-size: 0.64rem;
  }

  .app-sort-pill.is-active {
    border-color: var(--app-brand);
    background: rgba(168, 85, 247, 0.13);
    color: var(--app-brand-bright);
  }

  .sort-arrow {
    font-size: 0.64rem;
  }

  .app-filters {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.7rem;
  }

  .app-filter {
    display: inline-flex;
    align-items: center;
    height: 23px;
    padding: 0 0.52rem;
    border: 1px solid var(--app-line);
    border-radius: 5px;
    background: #151518;
    color: var(--app-muted);
    font-size: 0.58rem;
  }

  .app-filter.is-active {
    border-color: var(--app-brand);
    background: rgba(168, 85, 247, 0.13);
    color: #d8b4fe;
  }

  /* Variables table */
  .app-table {
    overflow: hidden;
    margin-top: 0.85rem;
    border: 1px solid var(--app-line);
    border-radius: 10px;
    background: #111114;
  }

  .app-table-head,
  .app-row {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr) 42px minmax(0, 1.2fr) minmax(0, 0.95fr)
      92px;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.85rem;
  }

  .app-table-head {
    height: 32px;
    border-bottom: 1px solid var(--app-line);
    color: var(--app-dim);
    font-family: var(--font-body);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .app-center {
    text-align: center;
  }

  .app-right {
    text-align: right;
  }

  .app-row {
    min-height: 46px;
    border-top: 1px solid var(--app-line-soft);
    transition: background-color 0.25s ease;
  }

  .app-row:first-of-type {
    border-top: 0;
  }

  .app-row:hover {
    background: rgba(255, 255, 255, 0.014);
  }

  .app-name {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .app-var-name {
    overflow: hidden;
    color: #e4e4e7;
    font-family: var(--font-code);
    font-size: 0.74rem;
    letter-spacing: 0.005em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-needs {
    flex: none;
    padding: 1px 4px;
    border-radius: 3px;
    background: rgba(251, 191, 36, 0.12);
    color: #fbbf24;
    font-size: 0.5rem;
    line-height: 1.5;
  }

  .app-status {
    display: flex;
    justify-content: center;
  }

  .app-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 7px rgba(74, 222, 128, 0.45);
  }

  .app-status-dot.is-inactive {
    background: var(--app-faint);
    box-shadow: none;
  }

  .app-value {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .value-text {
    overflow: hidden;
    color: var(--app-faint);
    font-family: var(--font-code);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      color 0.25s ease,
      letter-spacing 0.25s ease;
  }

  .app-row.is-plain .value-text {
    color: #d4d4d8;
    letter-spacing: 0;
  }

  .value-text.is-empty {
    color: var(--app-dim);
  }

  .app-countdown {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
    height: 18px;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: #27272a;
    color: var(--app-muted);
    font-family: var(--font-code);
    font-size: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .app-countdown[hidden] {
    display: none;
  }

  .app-tags {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    overflow: hidden;
  }

  .app-tag {
    flex: none;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(168, 85, 247, 0.17);
    color: #d8b4fe;
    font-size: 0.55rem;
    line-height: 1.55;
  }

  .app-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1px;
  }

  .app-icon-btn {
    display: grid;
    place-items: center;
    width: 23px;
    height: 23px;
    border-radius: 5px;
    color: var(--app-faint);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .app-icon-btn.is-ghost {
    opacity: 0.8;
  }

  .app-icon-btn.is-danger {
    opacity: 0.7;
  }

  .app-icon-btn.is-disabled {
    opacity: 0.3;
  }

  button.app-icon-btn:hover {
    background: #27272a;
    color: #e4e4e7;
  }

  .eye-show,
  .eye-hide {
    display: grid;
    place-items: center;
  }

  .eye-hide {
    display: none;
  }

  .app-row.is-plain .eye-show {
    display: none;
  }

  .app-row.is-plain .eye-hide {
    display: grid;
  }

  .app-row.is-plain .app-icon-btn[data-reveal-toggle] {
    color: var(--app-brand-bright);
    background: rgba(168, 85, 247, 0.1);
  }

  .app-row-inactive .app-var-name {
    color: var(--app-muted);
