---
import Icon from "./Icon.astro";
import GitHubIcon from "./GitHubIcon.astro";

const repo = "https://github.com/yannick2009/yily";
const links = [
  { href: "#why", label: "Why Yily" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#sdks", label: "SDKs" },
  { href: "#security", label: "Security" },
  { href: "#self-host", label: "Self-host" },
];
---

<div class="scroll-progress" data-progress aria-hidden="true"></div>

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label="Yily home">
      <img
        src="/logo.svg"
        alt=""
        width="180"
        height="169"
        class="brand-logo"
        decoding="async"
      />
    </a>

    <nav class="nav-links" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} data-nav-link>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <a
        class="btn btn-primary btn-sm nav-cta"
        href={repo}
        target="_blank"
        rel="noreferrer"
        aria-label="Star on GitHub"
      >
        <GitHubIcon size={16} />
        <span>Star on GitHub</span>
      </a>
      <button
        class="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
      >
        <span class="menu-icon menu-open-icon"><Icon name="menu" size={18} /></span>
        <span class="menu-icon menu-close-icon"><Icon name="x" size={18} /></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu data-open="false" aria-hidden="true">
  <div class="mobile-menu-inner">
    <nav class="mobile-links" aria-label="Mobile navigation">
      {
        links.map((link, i) => (
          <a href={link.href} style={`--delay:${i * 45 + 80}ms`}>
            <span class="mobile-index">{String(i + 1).padStart(2, "0")}</span>
            <span>{link.label}</span>
            <span class="mobile-arrow"><Icon name="arrow-up-right" size={17} /></span>
          </a>
        ))
      }
    </nav>
    <div class="mobile-foot">
      <a class="btn btn-primary" href={repo} target="_blank" rel="noreferrer">
        <GitHubIcon size={17} />
        Star on GitHub
      </a>
      <p>Self-hosted · AES-256-GCM · MIT</p>
    </div>
  </div>
</div>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
  }

  .site-nav::before {
    content: "";
    position: absolute;
    inset: 0;
    border-bottom: 1px solid transparent;
    background: rgba(7, 6, 10, 0.68);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .site-nav.is-scrolled::before {
    opacity: 1;
    border-bottom-color: var(--border);
  }

  :global(body.menu-open) .site-nav::before {
    opacity: 1;
    border-bottom-color: transparent;
  }

  .nav-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 76px;
    transition: height 0.35s var(--ease-out);
  }

  .site-nav.is-scrolled .nav-inner {
    height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .brand-logo {
    width: auto;
    height: 38px;
    filter: drop-shadow(0 0 16px rgba(131, 56, 236, 0.28));
    transition: filter 0.3s var(--ease-out);
  }

  .brand:hover .brand-logo {
    filter: drop-shadow(0 0 22px rgba(167, 139, 250, 0.55));
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .nav-links a {
    position: relative;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 430;
    letter-spacing: -0.005em;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-links a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--brand-bright);
    box-shadow: 0 0 8px rgba(167, 139, 250, 0.9);
    opacity: 0;
    transform: translateX(-50%) scale(0.4);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.035);
  }

  .nav-links a.is-active {
    color: var(--text);
  }

  .nav-links a.is-active::after {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  .nav-cta {
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.15);
  }

  .menu-btn {
    position: relative;
    display: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-soft);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .menu-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
  }

  .menu-icon {
    position: absolute;
    display: grid;
    place-items: center;
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease-out);
  }

  .menu-close-icon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  .menu-btn[aria-expanded="true"] .menu-open-icon {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  .menu-btn[aria-expanded="true"] .menu-close-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* Mobile panel */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    visibility: hidden;
    padding-top: 76px;
    background:
      radial-gradient(700px 420px at 80% 0%, rgba(131, 56, 236, 0.14), transparent 70%),
      rgba(7, 6, 10, 0.96);
    -webkit-backdrop-filter: blur(28px);
    backdrop-filter: blur(28px);
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-out),
      visibility 0.35s;
  }

  .mobile-menu[data-open="true"] {
    visibility: visible;
    opacity: 1;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    width: min(100% - 2rem, 560px);
    margin: 0 auto;
    padding: 2.25rem 0 2rem;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .mobile-links a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out),
      color 0.2s ease;
    transition-delay: var(--delay, 0ms);
  }

  .mobile-menu[data-open="true"] .mobile-links a {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-links a:hover {
    color: var(--text);
  }

  .mobile-index {
    width: 2.1rem;
    color: var(--brand-bright);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .mobile-arrow {
    margin-left: auto;
    color: var(--faint);
  }

  .mobile-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .mobile-foot p {
    color: var(--faint);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 1023px) {
    .nav-links {
      display: none;
    }

    .menu-btn {
      display: grid;
    }
  }

  @media (max-width: 640px) {
    .brand-logo {
      height: 34px;
    }

    .nav-inner {
      height: 68px;
      gap: 0.75rem;
    }

    .site-nav.is-scrolled .nav-inner {
      height: 60px;
    }

    .nav-cta span {
      display: none;
    }

    .nav-cta {
      width: 38px;
      height: 38px;
      padding: 0;
    }

    .mobile-menu {
      padding-top: 68px;
    }
  }
</style>
