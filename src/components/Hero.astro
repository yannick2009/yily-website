---
import Icon from "./Icon.astro";
import GitHubIcon from "./GitHubIcon.astro";
import YilyAppMockup from "./YilyAppMockup.astro";

const repo = "https://github.com/yannick2009/yily";
const releases = "https://github.com/yannick2009/yily/releases";
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <div class="container hero-inner">
    <a class="hero-badge" href={releases} target="_blank" rel="noreferrer">
      <span class="badge-live"><span class="badge-dot"></span>Now in public beta</span>
      <span class="badge-div"></span>
      <span class="badge-version">v1.0.0-beta.1</span>
      <span class="badge-arrow"><Icon name="arrow-up-right" size={12} /></span>
    </a>

    <h1 class="hero-title">
      <span class="hero-line"><span>Secrets management,</span></span>
      <span class="hero-line"><span class="serif gradient-text">without the weight.</span></span>
    </h1>

    <p class="hero-sub">
      Yily is a fast, self-hosted home for your API keys, tokens and passwords.
      One Go binary, one SQLite file, AES-256-GCM at rest. None of the ceremony.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href={repo} target="_blank" rel="noreferrer">
        <GitHubIcon size={18} />
        Star on GitHub
      </a>
      <a class="btn btn-ghost" href="#how-it-works">
        See how retrieval works
        <Icon name="arrow-down" size={16} class="icon-down" />
      </a>
    </div>

    <ul class="hero-bullets" aria-label="Highlights">
      <li><span class="bullet-check"><Icon name="check" size={12} /></span>Single Go binary</li>
      <li><span class="bullet-check"><Icon name="check" size={12} /></span>One SQLite file</li>
      <li><span class="bullet-check"><Icon name="check" size={12} /></span>MIT licensed</li>
    </ul>

    <div class="hero-stage">
      <div class="stage-halo" aria-hidden="true"></div>

      <div class="float-card float-a" aria-hidden="true">
        <span class="float-icon"><Icon name="lock" size={15} /></span>
        <span class="float-copy">
          <strong>AES-256-GCM</strong>
          <span>sealed at rest</span>
        </span>
      </div>

      <div class="float-card float-b" aria-hidden="true">
        <span class="float-icon"><Icon name="fingerprint" size={15} /></span>
        <span class="float-copy">
          <strong>AAD bound</strong>
          <span>yily:variable:version</span>
        </span>
      </div>

      <YilyAppMockup />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 156px 0 clamp(4rem, 7vw, 6rem);
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 76px;
    left: 50%;
    z-index: 1;
    width: min(82vw, 920px);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(196, 181, 253, 0.26), transparent);
    pointer-events: none;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: -1px;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.034) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.034) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 68% 56% at 50% 17%, #000 8%, transparent 72%);
    mask-image: radial-gradient(ellipse 68% 56% at 50% 17%, #000 8%, transparent 72%);
    opacity: 0.65;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    will-change: transform;
  }

  .orb-1 {
    top: -230px;
    left: 50%;
    width: 660px;
    height: 500px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(131, 56, 236, 0.55), transparent 72%);
    animation: drift-1 20s ease-in-out infinite alternate;
  }

  .orb-2 {
    top: 240px;
    right: -120px;
    width: 400px;
    height: 400px;
    background: radial-gradient(closest-side, rgba(232, 121, 249, 0.2), transparent 72%);
    animation: drift-2 24s ease-in-out infinite alternate;
  }

  .orb-3 {
    top: 420px;
    left: -120px;
    width: 360px;
    height: 360px;
    background: radial-gradient(closest-side, rgba(56, 189, 248, 0.14), transparent 72%);
    animation: drift-3 28s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    to { transform: translateX(-50%) translateY(26px) scale(1.06); }
  }
  @keyframes drift-2 {
    to { transform: translate(-24px, 20px) scale(1.08); }
  }
  @keyframes drift-3 {
    to { transform: translate(30px, -22px) scale(1.05); }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    height: 33px;
    padding: 0 0.55rem 0 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--text-soft);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    animation: hero-fade 0.8s 0.05s var(--ease-out) both;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .hero-badge:hover {
    border-color: rgba(167, 139, 250, 0.4);
    background: rgba(139, 92, 246, 0.08);
    color: var(--text);
  }

  .badge-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 10px rgba(94, 234, 212, 0.9);
    animation: badge-pulse 2.8s ease-in-out infinite;
  }

  @keyframes badge-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 10px rgba(94, 234, 212, 0.9); }
    50% { opacity: 0.55; box-shadow: 0 0 4px rgba(94, 234, 212, 0.4); }
  }

  .badge-div {
    width: 1px;
    height: 13px;
    background: var(--border-strong);
  }

  .badge-version {
    color: var(--faint);
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .badge-arrow {
    display: grid;
    place-items: center;
    color: var(--faint);
    transition:
      transform 0.25s var(--ease-out),
      color 0.25s ease;
  }

  .hero-badge:hover .badge-arrow {
    transform: translate(1px, -1px);
    color: var(--brand-bright);
  }

  .hero-title {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7.4vw, 6.3rem);
    font-weight: 590;
    line-height: 0.97;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding: 0.03em 0.06em 0.14em;
    margin-bottom: -0.12em;
  }

  .hero-line > span {
    display: block;
    animation: title-in 1.05s var(--ease-out) both;
  }

  .hero-line:nth-child(2) > span {
    animation-delay: 0.12s;
  }

  .hero-line .serif {
    font-size: 1.04em;
    padding-right: 0.06em;
  }

  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(108%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-sub {
    max-width: 650px;
    margin-top: 1.4rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.125rem);
    line-height: 1.72;
    text-wrap: pretty;
    animation: hero-fade 0.9s 0.28s var(--ease-out) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 2.1rem;
    animation: hero-fade 0.9s 0.38s var(--ease-out) both;
  }

  .hero-bullets {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.3rem;
    margin-top: 1.35rem;
    color: var(--faint);
    font-size: 0.75rem;
    letter-spacing: 0.005em;
    animation: hero-fade 0.9s 0.46s var(--ease-out) both;
  }

  .hero-bullets li {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .bullet-check {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: rgba(94, 234, 212, 0.09);
    color: var(--success);
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-stage {
    position: relative;
    width: 100%;
    max-width: 1140px;
    margin-top: clamp(3rem, 5.5vw, 4.6rem);
    animation: stage-in 1.2s 0.42s var(--ease-out) both;
  }

  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(38px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .stage-halo {
    position: absolute;
    inset: -10% -6% -16%;
    z-index: 0;
    border-radius: 50%;
    background:
      radial-gradient(50% 50% at 50% 44%, rgba(139, 92, 246, 0.18), transparent 70%),
      radial-gradient(30% 38% at 80% 40%, rgba(232, 121, 249, 0.1), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }

  /* Floating chips */
  .float-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 13px;
    background: rgba(13, 11, 19, 0.78);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 1px 0 rgba(255, 255, 255, 0.07) inset;
    animation: float-bob 7s ease-in-out infinite;
  }

  .float-a {
    top: 35%;
    left: -142px;
    animation-delay: -2.5s;
    transform: rotate(-1.2deg);
  }

  .float-b {
    top: 14%;
    right: -142px;
    animation-delay: -4s;
    transform: rotate(1.2deg);
  }

  @keyframes float-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  .float-icon {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 8px;
    background: rgba(139, 92, 246, 0.1);
    color: var(--brand-bright);
  }

  .float-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    white-space: nowrap;
  }

  .float-copy strong {
    color: var(--text-soft);
    font-size: 0.68rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .float-copy span {
    color: var(--faint);
    font-family: var(--font-body);
    font-size: 0.56rem;
    letter-spacing: 0;
  }

  @media (max-width: 1439px) {
    .float-card {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 126px;
    }

    .hero::before {
      top: 68px;
    }

    .orb {
      animation: none;
      filter: blur(68px);
      opacity: 0.42;
    }

    .orb-1 {
      width: 520px;
      height: 380px;
      top: -190px;
    }

    .orb-2 {
      width: 300px;
      height: 300px;
    }

    .orb-3 {
      width: 260px;
      height: 260px;
    }

    .hero-title {
      margin-top: 1.45rem;
      font-size: clamp(2rem, 9.2vw, 3.1rem);
      letter-spacing: -0.052em;
    }

    .hero-sub {
      margin-top: 1.15rem;
      font-size: 0.98rem;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
      margin-top: 1.7rem;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-bullets {
      margin-top: 1.15rem;
      gap: 0.45rem 0.9rem;
      font-size: 0.68rem;
    }

    .hero-badge {
      height: 31px;
      gap: 0.5rem;
      font-size: 0.65rem;
    }

    .badge-version,
    .badge-div {
      display: none;
    }

    .hero-stage {
      margin-top: 2.7rem;
    }
  }
</style>
