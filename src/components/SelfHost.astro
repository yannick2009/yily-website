---
import Icon from "./Icon.astro";

const readme = "https://github.com/yannick2009/yily/blob/main/README.md";

const paths = [
  {
    title: "Docker",
    desc: "The recommended route. Pin the beta tag.",
    href: `${readme}#docker`,
    icon: "box" as const,
  },
  {
    title: "Server binary",
    desc: "Linux amd64 tarball, web client included.",
    href: `${readme}#server-binary-linux`,
    icon: "file" as const,
  },
  {
    title: "CLI",
    desc: "Install yily-cli on Linux or macOS.",
    href: `${readme}#cli`,
    icon: "terminal" as const,
  },
];
---

<section class="section self-host" id="self-host">
  <div class="container self-grid">
    <div class="self-copy" data-reveal>
      <div class="section-header left">
        <span class="eyebrow">Self-hosting</span>
        <h2 class="section-title">
          Up in a minute.<br />
          <span class="serif gradient-text">Yours for good.</span>
        </h2>
        <p class="section-lede">
          Generate one master key, start one container and open the dashboard. The
          API, the web interface and the data all stay on your infrastructure.
        </p>
      </div>

      <div class="paths">
        {
          paths.map((path) => (
            <a class="path" href={path.href} target="_blank" rel="noreferrer">
              <span class="path-icon"><Icon name={path.icon} size={15} /></span>
              <span class="path-copy">
                <strong>{path.title}</strong>
                <em>{path.desc}</em>
              </span>
              <span class="path-arrow"><Icon name="arrow-up-right" size={14} /></span>
            </a>
          ))
        }
      </div>

      <div class="key-warning">
        <span class="warning-icon"><Icon name="warning" size={15} /></span>
        <p>
          <strong>Guard the master key.</strong> If it is lost, the encrypted values
          are unrecoverable. That is by design. Store it outside the database and
          back it up.
        </p>
      </div>
    </div>

    <div class="self-visual" data-reveal style="--reveal-delay: 100ms">
      <div class="terminal">
        <div class="terminal-bar">
          <span class="win-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="terminal-title">bash · yily</span>
        </div>

        <div class="terminal-body">
          <div class="term-block key-block">
            <div class="term-block-head">
              <span class="term-step"><span>1</span> Generate your master key</span>
              <button
                class="copy-btn"
                type="button"
                data-copy-block
                aria-label="Copy the master key command"
              >
                <Icon name="copy" size={12} class="icon-copy" />
                <Icon name="check" size={12} class="icon-check" />
                <span data-copy-label>Copy</span>
              </button>
            </div>
            <pre><code><span class="t-cmd">echo</span> <span class="t-str">"YILY_MASTER_KEY=$(<span class="t-fn">openssl rand -base64 32</span>)"</span> &gt; yily.env
<span class="t-cmd">chmod</span> <span class="t-num">600</span> yily.env</code></pre>
          </div>

          <div class="deploy" data-deploy>
            <div class="deploy-tabs" role="tablist" aria-label="Choose an install method">
              <button
                type="button"
                role="tab"
                id="deploy-tab-docker"
                aria-controls="deploy-panel-docker"
                aria-selected="true"
                tabindex="0"
                class="deploy-tab is-active"
                data-deploy-tab="docker"
              >
                <span class="deploy-tab-num">1</span> Docker
              </button>
              <button
                type="button"
                role="tab"
                id="deploy-tab-compose"
                aria-controls="deploy-panel-compose"
                aria-selected="false"
                tabindex="-1"
                class="deploy-tab"
                data-deploy-tab="compose"
              >
                <span class="deploy-tab-num">2</span> Compose
              </button>
              <button
                type="button"
                role="tab"
                id="deploy-tab-binary"
                aria-controls="deploy-panel-binary"
                aria-selected="false"
                tabindex="-1"
                class="deploy-tab"
                data-deploy-tab="binary"
              >
                <span class="deploy-tab-num">3</span> Binary
              </button>
            </div>

            <div class="deploy-deck">
              <div
                class="deploy-panel is-active"
                id="deploy-panel-docker"
                role="tabpanel"
                aria-labelledby="deploy-tab-docker"
                data-deploy-panel="docker"
              >
                <div class="term-block">
                  <div class="term-block-head">
                    <span class="term-step"><span>1</span> Start the container</span>
                    <button
                      class="copy-btn"
                      type="button"
                      data-copy-block
                      aria-label="Copy the Docker command"
                    >
                      <Icon name="copy" size={12} class="icon-copy" />
                      <Icon name="check" size={12} class="icon-check" />
                      <span data-copy-label>Copy</span>
                    </button>
                  </div>
                  <pre><code><span class="t-cmd">docker run</span> -d --name yily \
  --restart unless-stopped \
  -p <span class="t-num">16529</span>:<span class="t-num">16529</span> \
  -v yily-data:/data \
  --env-file yily.env \
  <span class="t-img">ghcr.io/yannick2009/yily:1.0.0-beta.1</span></code></pre>
                </div>
              </div>

              <div
                class="deploy-panel"
                id="deploy-panel-compose"
                role="tabpanel"
                aria-labelledby="deploy-tab-compose"
                data-deploy-panel="compose"
                hidden
              >
                <div class="term-block">
                  <div class="term-block-head">
                    <span class="term-step"><span>2</span> Docker Compose</span>
                    <button
                      class="copy-btn"
                      type="button"
                      data-copy-block
                      aria-label="Copy the Docker Compose file"
                    >
                      <Icon name="copy" size={12} class="icon-copy" />
                      <Icon name="check" size={12} class="icon-check" />
                      <span data-copy-label>Copy</span>
                    </button>
                  </div>
                  <pre><code><span class="t-cmd">services</span>:
  <span class="t-cmd">yily</span>:
    <span class="t-cmd">image</span>: <span class="t-img">ghcr.io/yannick2009/yily:1.0.0-beta.1</span>
    <span class="t-cmd">restart</span>: <span class="t-str">unless-stopped</span>
    <span class="t-cmd">ports</span>:
      - <span class="t-num">"16529:16529"</span>
    <span class="t-cmd">volumes</span>:
      - <span class="t-str">yily-data:/data</span>
    <span class="t-cmd">env_file</span>:
      - <span class="t-str">yily.env</span>

<span class="t-cmd">volumes</span>:
  <span class="t-str">yily-data</span>:</code></pre>
                  <div class="term-compose-run">
                    <span class="term-compose-run-label">run</span>
                    <code><span class="t-cmd">docker compose</span> up -d</code>
                  </div>
                </div>
              </div>

              <div
                class="deploy-panel"
                id="deploy-panel-binary"
                role="tabpanel"
                aria-labelledby="deploy-tab-binary"
                data-deploy-panel="binary"
                hidden
              >
                <div class="term-block">
                  <div class="term-block-head">
                    <span class="term-step"><span>3</span> Download the server binary</span>
                    <button
                      class="copy-btn"
                      type="button"
                      data-copy-block
                      aria-label="Copy the binary download commands"
                    >
                      <Icon name="copy" size={12} class="icon-copy" />
                      <Icon name="check" size={12} class="icon-check" />
                      <span data-copy-label>Copy</span>
                    </button>
                  </div>
                  <pre><code><span class="t-cmd">curl</span> -LO <span class="t-str">https://github.com/yannick2009/yily/releases/download/v1.0.0-beta.1/yily_1.0.0-beta.1_linux_amd64.tar.gz</span>
<span class="t-cmd">tar</span> -xzf <span class="t-str">yily_1.0.0-beta.1_linux_amd64.tar.gz</span>
<span class="t-cmd">set -a</span>; <span class="t-cmd">source</span> <span class="t-str">./yily.env</span>; <span class="t-cmd">set +a</span>   <span class="t-cmt"># exports YILY_MASTER_KEY</span>
<span class="t-cmd">./yily_1.0.0-beta.1_linux_amd64/yily</span></code></pre>
                </div>
              </div>
            </div>
          </div>

          <div class="term-open">
            <span class="term-ready"><span class="live-dot"></span> running</span>
            <span class="term-open-sep">/</span>
            <span>open <a href="http://localhost:16529" target="_blank" rel="noreferrer" aria-label="Open the Yily dashboard at localhost:16529">localhost:16529</a></span>
            <span class="term-open-arrow"><Icon name="arrow-up-right" size={11} /></span>
          </div>
        </div>
      </div>

      <p class="arch-note">
        <Icon name="warning" size={12} />
        <span>
          The current image is <code>linux/amd64</code>. On ARM, run it with
          <code>--platform linux/amd64</code> until a native build ships.
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .self-host {
    background:
      radial-gradient(900px 520px at 85% 30%, rgba(139, 92, 246, 0.06), transparent 70%);
  }

  .self-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
  }

  .self-copy .section-header {
    margin-bottom: 1.8rem;
  }

  .paths {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 470px;
  }

  .path {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.016);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .path:hover {
    border-color: rgba(167, 139, 250, 0.22);
    background: rgba(139, 92, 246, 0.045);
    transform: translateX(2px);
  }

  .path-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 8px;
    background: rgba(139, 92, 246, 0.07);
    color: var(--brand-bright);
  }

  .path-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }

  .path-copy strong {
    color: var(--text-soft);
    font-size: 0.8rem;
    font-weight: 520;
    letter-spacing: -0.015em;
  }

  .path-copy em {
    color: var(--faint);
    font-size: 0.67rem;
    font-style: normal;
  }

  .path-arrow {
    display: grid;
    place-items: center;
    margin-left: auto;
    color: #57515f;
    transition:
      color 0.2s ease,
      transform 0.25s var(--ease-out);
  }

  .path:hover .path-arrow {
    color: var(--brand-bright);
    transform: translate(1px, -1px);
  }

  .key-warning {
    display: flex;
    gap: 0.7rem;
    max-width: 470px;
    margin-top: 1.1rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(251, 191, 36, 0.14);
    border-radius: 11px;
    background: rgba(251, 191, 36, 0.035);
  }

  .warning-icon {
    flex: none;
    margin-top: 1px;
    color: rgba(251, 191, 36, 0.8);
  }

  .key-warning p {
    color: #9f947a;
    font-size: 0.71rem;
    line-height: 1.6;
  }

  .key-warning strong {
    color: #d9c99d;
    font-weight: 520;
  }

  /* Terminal */
  .self-visual {
    min-width: 0;
  }

  .terminal {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: #09070d;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 40px 100px -30px rgba(0, 0, 0, 0.85),
      0 0 60px rgba(124, 58, 237, 0.07);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 43px;
    padding: 0 0.95rem;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.018);
  }

  .win-dots {
    display: flex;
    gap: 6px;
  }

  .win-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #282230;
  }

  .win-dots span:first-child {
    background: #383043;
  }

  .terminal-title {
    color: var(--faint);
    font-family: var(--font-code);
    font-size: 0.6rem;
  }

  .terminal-body {
    background:
      radial-gradient(400px 200px at 100% 0%, rgba(139, 92, 246, 0.055), transparent 75%);
  }

  /* Deploy tabs + stacked panels */
  .deploy-tabs {
    display: flex;
    align-items: flex-end;
    overflow-x: auto;
    padding: 0.55rem 0.55rem 0;
    background: rgba(255, 255, 255, 0.014);
    scrollbar-width: none;
  }

  .deploy-tabs::-webkit-scrollbar {
    display: none;
  }

  .deploy-tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    height: 34px;
    padding: 0 0.85rem;
    margin-left: -6px;
    margin-bottom: -1px;
    border: 1px solid var(--border);
    border-radius: 9px 9px 0 0;
    background: #0c0a12;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 450;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .deploy-tab:first-child {
    margin-left: 0;
  }

  .deploy-tab:hover {
    color: var(--text);
  }

  .deploy-tab.is-active {
    z-index: 3;
    background: #09070d;
    color: var(--text);
    border-color: var(--border-strong);
    border-bottom-color: transparent;
  }

  .deploy-tab-num {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 1px solid rgba(167, 139, 250, 0.22);
    border-radius: 50%;
    color: var(--brand-bright);
    font-family: var(--font-code);
    font-size: 0.5rem;
    transition: border-color 0.2s ease;
  }

  .deploy-tab.is-active .deploy-tab-num {
    border-color: rgba(167, 139, 250, 0.45);
  }

  .deploy-deck {
    position: relative;
    border-top: 1px solid var(--border);
  }

  .deploy-panel.is-active {
    animation: deploy-panel-in 0.45s var(--ease-out);
  }

  @keyframes deploy-panel-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .key-block {
    border-bottom: 1px solid var(--border);
  }

  .term-block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem 0;
  }

  .term-step {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #746d82;
    font-family: var(--font-code);
    font-size: 0.57rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .term-step > span {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1px solid rgba(167, 139, 250, 0.22);
    border-radius: 50%;
    color: var(--brand-bright);
    font-size: 0.46rem;
    letter-spacing: 0;
  }

  .term-block pre {
    overflow-x: auto;
    margin: 0;
    padding: 0.7rem 1rem 1rem;
    scrollbar-width: thin;
    scrollbar-color: #2a2434 transparent;
  }

  .term-block code {
    color: #c9c2d6;
    font-family: var(--font-code);
    font-size: 0.68rem;
    line-height: 1.85;
    white-space: pre;
  }

  .term-compose-run {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem 0.95rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.07);
  }

  .term-compose-run-label {
    color: #57515f;
    font-family: var(--font-code);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .t-cmd {
    color: #d8b4fe;
  }

  .t-fn {
    color: #99f6e4;
  }

  .t-str {
    color: #cfc8dd;
  }

  .t-num {
    color: #f0abfc;
  }

  .t-img {
    color: #a78bfa;
  }

  .t-cmt {
    color: #5d5769;
  }

  .term-open {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--border);
    color: #625c70;
    font-family: var(--font-code);
    font-size: 0.57rem;
  }

  .term-ready {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(204, 251, 241, 0.65);
  }

  .live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px rgba(94, 234, 212, 0.8);
  }

  .term-open-sep {
    color: #3e3948;
  }

  .term-open a {
    color: var(--text-soft);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .term-open a:hover {
    color: var(--brand-bright);
    border-color: rgba(167, 139, 250, 0.4);
  }

  .term-open-arrow {
    color: #57515f;
    display: inline-flex;
  }

  .arch-note {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin-top: 0.85rem;
    padding-left: 0.2rem;
    color: #5f596b;
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .arch-note svg {
    flex: none;
    margin-top: 1px;
  }

  .arch-note code {
    color: #8a839c;
    font-size: 0.63rem;
  }

  @media (max-width: 1080px) {
    .self-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .paths,
    .key-warning {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .term-block code {
      font-size: 0.6rem;
      white-space: pre-wrap;
      overflow-wrap: break-word;
    }

    .term-block pre {
      overflow-x: hidden;
    }

    .term-block-head {
      flex-wrap: wrap;
    }

    .term-block {
      overflow: hidden;
    }
  }
</style>
