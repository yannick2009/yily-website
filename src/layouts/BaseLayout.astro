---
import "../styles/global.css";
import { VERSION } from "../config";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Yily: Self-hosted secret manager for API keys and .env",
  description = "Stop scattering API keys and tokens across .env files. Yily is a self-hosted secret manager: one Go binary, one SQLite file, AES-256-GCM at rest.",
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const siteUrl = Astro.site ? new URL("/", Astro.site).href : "https://yily.dev/";
const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";
const logoUrl = Astro.site ? new URL("/logo.svg", Astro.site).href : "/logo.svg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Yily",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  description,
  url: siteUrl,
  image: ogImage,
  screenshot: ogImage,
  license: "https://opensource.org/licenses/MIT",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  softwareVersion: VERSION,
  sameAs: ["https://github.com/yannick2009/yily"],
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Yily",
  url: siteUrl,
  logo: logoUrl,
  sameAs: ["https://github.com/yannick2009/yily"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {Astro.site && !noindex && <link rel="canonical" href={canonicalURL} />}

    <meta name="theme-color" content="#07060a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yily" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Yily: One home for your secrets, not scattered across .env files."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/inter-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {!noindex && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    )}
    <script
      is:inline
      defer
      src="https://umami-production-3e01.up.railway.app/script.js"
      data-website-id="ea9c2460-67ad-42ae-8709-44b0c6ac235e"
    ></script>
    <script
      is:inline
      defer
      src="https://umami-production-3e01.up.railway.app/recorder.js"
      data-website-id="ea9c2460-67ad-42ae-8709-44b0c6ac235e"
      data-sample-rate="0.1"
      data-mask-level="moderate"
      data-max-duration="300000"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-noise" aria-hidden="true"></div>
    <slot />

    <script>
      // Keep the "Star on GitHub" star counts in sync with the repository.
      const REPO = "yannick2009/yily";
      const CACHE_KEY = "yily:github-stars";
      const CACHE_TTL = 10 * 60 * 1000;

      type CachedStars = { count: number; at: number };

      const stars = document.querySelectorAll<HTMLElement>("[data-star-count]");

      if (stars.length > 0) {
        const compact = new Intl.NumberFormat("en", {
          notation: "compact",
          maximumFractionDigits: 1,
        });

        const formatCount = (count: number) =>
          count < 1000 ? String(count) : compact.format(count).toLowerCase();

        const paint = (count: number) => {
          const label = formatCount(count);
          stars.forEach((node) => {
            const value = node.querySelector<HTMLElement>("[data-star-count-value]");
            if (!value) return;
            value.textContent = label;
            node.classList.add("is-ready");
          });
        };

        const readCache = (): CachedStars | null => {
          try {
            const raw = window.localStorage.getItem(CACHE_KEY);
            if (!raw) return null;
            const parsed: Partial<CachedStars> = JSON.parse(raw);
            if (typeof parsed.count !== "number" || typeof parsed.at !== "number") {
              return null;
            }
            return { count: parsed.count, at: parsed.at };
          } catch {
            return null;
          }
        };

        const writeCache = (count: number) => {
          try {
            window.localStorage.setItem(CACHE_KEY, JSON.stringify({ count, at: Date.now() }));
          } catch {
            /* Storage unavailable: the count still renders for this visit. */
          }
        };

        const refreshStars = async () => {
          const cached = readCache();
          if (cached) paint(cached.count);
          if (cached && Date.now() - cached.at < CACHE_TTL) return;

          try {
            const response = await fetch(`https://api.github.com/repos/${REPO}`, {
              headers: { Accept: "application/vnd.github+json" },
            });
            if (!response.ok) return;
            const repo: { stargazers_count?: number } = await response.json();
            if (typeof repo.stargazers_count !== "number") return;
            paint(repo.stargazers_count);
            writeCache(repo.stargazers_count);
          } catch {
            /* Offline or rate-limited: keep the cached value if we had one. */
          }
        };

        void refreshStars();
      }
    </script>
  </body>
</html>
