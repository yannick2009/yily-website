# Custom Caddyfile for the Railway / Railpack static deployment.
# Based on Railpack's Node SPA template, with:
#   - long-lived caching for content-hashed assets
#   - revalidation for HTML
#   - a real 404 status that serves /404.html (see Staticfile: index_fallback: false)

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		# Prevent some browsers from MIME-sniffing a response away from the declared Content-Type
		X-Content-Type-Options "nosniff"
		# Remove Server header
		-Server
	}

	root * {{.DIST_DIR}}

	# Content-hashed build assets and fonts never change under the same URL.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML documents must revalidate so a new deploy is picked up immediately.
	@html path / /index.html /404.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Small unhashed static files: cache for a day.
	@assets path /favicon.ico /favicon.svg /favicon-32.png /apple-touch-icon.png /og.png /logo.svg /robots.txt /sitemap-index.xml /sitemap-0.xml /install.sh
	header @assets Cache-Control "public, max-age=86400"

	encode {
		gzip
		zstd
	}

	# Match direct HTML files, folder-level index.html, and optionally fall back
	# to the root index.html for SPA-style apps.
	try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}

	file_server {
		hide .git
		hide .env*
	}

	handle_errors {
		header Cache-Control "no-store"
		rewrite * /{err.status_code}.html
		file_server
	}
}
